---
import '../styles/global.css';
import { SITE } from '../config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}
const { title, description = SITE.description, type = 'website' } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { label: 'IGCSE Physics', href: url('igcse/') },
  { label: 'A Level', href: url('a-level/') },
  { label: 'Free Resources', href: url('resources/') },
  { label: 'About', href: url('about/') },
];
const socials = Object.entries(SITE.social).filter(([, v]) => v);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-40 bg-cream/90 backdrop-blur border-b-2 border-[#d6e0f5]">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
        <a href={url()} class="flex items-center gap-2 font-display text-xl font-bold">
          <span class="grid h-10 w-10 place-items-center rounded-2xl bg-sky text-xl text-white">⚛</span>
          <span>Brainwave <span class="text-sky">Physics</span></span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          {nav.map((n) => (
            <a href={n.href} class="rounded-full px-4 py-2 font-bold hover:bg-sun-soft">{n.label}</a>
          ))}
        </nav>

        <details class="relative md:hidden">
          <summary class="btn cursor-pointer list-none bg-sun px-4 py-2">Menu ☰</summary>
          <div class="card absolute right-0 mt-2 flex w-56 flex-col p-2">
            {nav.map((n) => (
              <a href={n.href} class="rounded-xl px-4 py-2 font-bold hover:bg-sun-soft">{n.label}</a>
            ))}
          </div>
        </details>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="mt-16 border-t-2 border-[#d6e0f5] bg-white">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
        <div>
          <p class="font-display text-lg font-bold">{SITE.name}</p>
          <p class="mt-2 text-sm text-ink/70">{SITE.tagline}. Free for every student.</p>
        </div>
        <div>
          <p class="font-display font-bold">Explore</p>
          <ul class="mt-2 space-y-1 text-sm">
            {nav.map((n) => (
              <li><a href={n.href} class="hover:text-sky">{n.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="font-display font-bold">Follow us</p>
          {socials.length ? (
            <ul class="mt-2 space-y-1 text-sm capitalize">
              {socials.map(([name, link]) => (
                <li><a href={link} target="_blank" rel="noopener" class="hover:text-sky">{name}</a></li>
              ))}
            </ul>
          ) : (
            <p class="mt-2 text-sm text-ink/70">YouTube, Facebook and Instagram coming soon.</p>
          )}
        </div>
      </div>
      <p class="border-t border-[#d6e0f5] py-4 text-center text-xs text-ink/60">
        © {new Date().getFullYear()} {SITE.name}. All rights reserved.
      </p>
    </footer>
  </body>
</html>
