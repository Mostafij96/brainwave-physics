---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found">
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="text-7xl">🛰️</p>
    <h1 class="mt-4 text-4xl font-extrabold">Lost in space</h1>
    <p class="mt-3 text-ink/70">We couldn't find that page.</p>
    <a href={url()} class="btn mt-6 bg-sky text-white">Back to home</a>
  </div>
</Base>
