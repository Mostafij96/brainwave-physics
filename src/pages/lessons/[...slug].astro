---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const all = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry) => {
    const sameLevel = all.filter((l) => l.data.level === entry.data.level);
    const i = sameLevel.findIndex((l) => l.id === entry.id);
    return {
      params: { slug: entry.id },
      props: { entry, prev: sameLevel[i - 1], next: sameLevel[i + 1] },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const badge = d.level === 'O Level' ? 'bg-mint-soft text-emerald-800' : 'bg-grape-soft text-violet-800';
---

<Base title={`${d.title} (${d.level} Physics)`} description={d.description} type="article">
  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav class="text-sm font-bold text-ink/60">
      <a href={url('lessons/')} class="hover:text-sky">Lessons</a> ›
      <a href={url(`lessons/#${d.level === 'O Level' ? 'o-level' : 'a-level'}`)} class="hover:text-sky">{d.level}</a>
    </nav>

    <div class="mt-4 flex flex-wrap items-center gap-2">
      <span class={`rounded-full px-3 py-1 text-xs font-extrabold ${badge}`}>{d.level}</span>
      <span class="rounded-full bg-sky-soft px-3 py-1 text-xs font-extrabold text-sky">{d.topic}</span>
      <span class="text-sm font-bold text-ink/50">⏱ {d.minutes} min read</span>
    </div>

    <h1 class="mt-3 text-4xl font-extrabold leading-tight">{d.title}</h1>
    <p class="mt-3 text-lg text-ink/70">{d.description}</p>

    {d.youtube && (
      <div class="mt-8 aspect-video overflow-hidden rounded-3xl border-2 border-[#d6e0f5] bg-black">
        <iframe
          class="h-full w-full"
          src={`https://www.youtube-nocookie.com/embed/${d.youtube}`}
          title={d.title}
          loading="lazy"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <div class="lesson-prose prose prose-lg mt-8 max-w-none">
      <Content />
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2">
      {prev ? (
        <a href={url(`lessons/${prev.id}/`)} class="card block p-5">
          <p class="text-xs font-extrabold text-ink/50">← PREVIOUS</p>
          <p class="mt-1 font-extrabold">{prev.data.title}</p>
        </a>
      ) : <div></div>}
      {next && (
        <a href={url(`lessons/${next.id}/`)} class="card block bg-sun-soft p-5 text-right">
          <p class="text-xs font-extrabold text-ink/50">NEXT →</p>
          <p class="mt-1 font-extrabold">{next.data.title}</p>
        </a>
      )}
    </div>
  </article>
</Base>
