---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url } from '../../lib/url';

const all = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { level: 'O Level', id: 'o-level', emoji: '🌱', bg: 'bg-mint-soft', badge: 'bg-mint-soft text-emerald-800' },
  { level: 'A Level', id: 'a-level', emoji: '🚀', bg: 'bg-grape-soft', badge: 'bg-grape-soft text-violet-800' },
];
---

<Base
  title="Physics Lessons – O Level & A Level"
  description="Browse free O Level and A Level Physics lessons with simple explanations, formulas and worked examples."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-extrabold">All Physics Lessons</h1>
    <p class="mt-2 text-ink/70">Pick your level and start learning. Every lesson is free.</p>

    {groups.map((g) => {
      const items = all.filter((l) => l.data.level === g.level);
      return (
        <section id={g.id} class="mt-12 scroll-mt-24">
          <h2 class={`inline-block rounded-full px-5 py-2 text-2xl font-extrabold ${g.bg}`}>{g.emoji} {g.level}</h2>
          {items.length === 0 ? (
            <p class="mt-4 text-ink/60">Lessons coming soon.</p>
          ) : (
            <div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {items.map((l) => (
                <a href={url(`lessons/${l.id}/`)} class="card block p-6">
                  <span class={`rounded-full px-3 py-1 text-xs font-extrabold ${g.badge}`}>{l.data.topic}</span>
                  <h3 class="mt-3 text-xl font-extrabold">{l.data.title}</h3>
                  <p class="mt-2 text-sm text-ink/70">{l.data.description}</p>
                  <p class="mt-4 text-sm font-bold text-ink/50">⏱ {l.data.minutes} min read</p>
                </a>
              ))}
            </div>
          )}
        </section>
      );
    })}
  </div>
</Base>
