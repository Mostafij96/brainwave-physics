---
import { getCollection, render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import { findChapter, COLORS } from '../../../../data/curriculum';
import { url } from '../../../../lib/url';

export async function getStaticPaths() {
  const all = await getCollection('lessons');
  return all.map((entry) => {
    const [, unit, chapter, lesson] = entry.id.split('/');
    const siblings = all
      .filter((l) => l.id.split('/')[2] === chapter)
      .sort((a, b) => a.data.order - b.data.order);
    const i = siblings.findIndex((l) => l.id === entry.id);
    return {
      params: { unit, chapter, lesson },
      props: { entry, siblings, prev: siblings[i - 1], next: siblings[i + 1] },
    };
  });
}

const { unit: unitSlug, chapter: chapterSlug } = Astro.params;
const { entry, siblings, prev, next } = Astro.props;
const { unit, chapter } = findChapter(unitSlug!, chapterSlug!)!;
const col = COLORS[chapter.color];
const { Content } = await render(entry);
const d = entry.data;

const base = `igcse/${unit.slug}/${chapter.slug}`;
const href = (id: string) => url(`${base}/${id.split('/')[3]}/`);
const specPoints = d.spec ? d.spec.split('|').map((s) => s.trim()).filter(Boolean) : [];
---

<Base title={`${d.title} – Topic ${chapter.n} ${chapter.title}`} description={d.description} type="article">
  <div class="mx-auto max-w-6xl px-4 py-10">
    <nav class="text-sm font-bold text-ink/60">
      <a href={url('igcse/')} class="hover:text-sky">IGCSE Physics</a> ›
      <span>{unit.title}</span> ›
      <a href={url(`${base}/`)} class="hover:text-sky">Chapter {chapter.n}: {chapter.title}</a>
    </nav>

    <div class="mt-6 grid gap-8 lg:grid-cols-[17rem_minmax(0,1fr)]">
      <!-- Chapter contents -->
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <details class="card p-4 lg:open:block" open>
          <summary class="cursor-pointer list-none font-display text-sm font-extrabold lg:cursor-default">
            {chapter.emoji} Chapter {chapter.n}: {chapter.title} <span class="lg:hidden">▾</span>
          </summary>
          <ol class="mt-3 space-y-1">
            {siblings.map((l) => (
              <li>
                <a
                  href={href(l.id)}
                  class:list={[
                    'flex gap-2 rounded-xl px-3 py-2 text-sm font-bold hover:bg-sun-soft',
                    l.id === entry.id && `${col.soft} text-ink`,
                  ]}
                  aria-current={l.id === entry.id ? 'page' : undefined}
                >
                  <span class="w-5 shrink-0 text-ink/40">{l.data.order}</span>
                  <span>{l.data.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </details>
      </aside>

      <!-- Lesson -->
      <article class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <span class={`rounded-full px-3 py-1 text-xs font-extrabold ${col.badge}`}>Topic {chapter.n}</span>
          <span class="rounded-full bg-white px-3 py-1 text-xs font-extrabold text-ink/60 border-2 border-[#d6e0f5]">
            Section {d.order} of {siblings.length}
          </span>
          <span class="text-sm font-bold text-ink/50">⏱ {d.minutes} min read</span>
        </div>

        <h1 class="mt-3 text-3xl font-extrabold leading-tight md:text-4xl">{d.title}</h1>

        {specPoints.length > 0 && (
          <div class="mt-4 rounded-2xl border-2 border-dashed border-[#c5d3f0] bg-white/70 p-4">
            <p class="text-xs font-extrabold uppercase tracking-wide text-ink/50">📌 Edexcel specification points</p>
            <ul class="mt-2 space-y-1 text-sm font-bold">
              {specPoints.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        )}

        {d.youtube && (
          <div class="mt-8 aspect-video overflow-hidden rounded-3xl border-2 border-[#d6e0f5] bg-black">
            <iframe
              class="h-full w-full"
              src={`https://www.youtube-nocookie.com/embed/${d.youtube}`}
              title={d.title}
              loading="lazy"
              allowfullscreen
            ></iframe>
          </div>
        )}

        <div class="lesson-prose prose prose-lg mt-8 max-w-none">
          <Content />
        </div>

        <div class="mt-12 grid gap-4 sm:grid-cols-2">
          {prev ? (
            <a href={href(prev.id)} class="card block p-5">
              <p class="text-xs font-extrabold text-ink/50">← PREVIOUS</p>
              <p class="mt-1 font-extrabold">{prev.data.title}</p>
            </a>
          ) : <div></div>}
          {next ? (
            <a href={href(next.id)} class="card block bg-sun-soft p-5 text-right">
              <p class="text-xs font-extrabold text-ink/50">NEXT →</p>
              <p class="mt-1 font-extrabold">{next.data.title}</p>
            </a>
          ) : (
            <a href={url(`${base}/`)} class="card block bg-mint-soft p-5 text-right">
              <p class="text-xs font-extrabold text-ink/50">CHAPTER COMPLETE 🎉</p>
              <p class="mt-1 font-extrabold">Back to chapter contents</p>
            </a>
          )}
        </div>
      </article>
    </div>
  </div>
</Base>
