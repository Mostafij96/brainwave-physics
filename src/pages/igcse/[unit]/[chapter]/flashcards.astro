---
import Base from '../../../../layouts/Base.astro';
import { IGCSE, COLORS, findChapter } from '../../../../data/curriculum';
import { getDeck, cardCount } from '../../../../lib/flashcards';
import { url } from '../../../../lib/url';

export function getStaticPaths() {
  return IGCSE.flatMap((unit) =>
    unit.chapters.filter((c) => getDeck(c.slug)).map((c) => ({ params: { unit: unit.slug, chapter: c.slug } })),
  );
}

const { unit: unitSlug, chapter: chapterSlug } = Astro.params;
const { unit, chapter } = findChapter(unitSlug!, chapterSlug!)!;
const deck = getDeck(chapter.slug)!;
const total = cardCount(deck);
const col = COLORS[chapter.color];

// Flatten for the browser; each card keeps its section index.
const cards = deck.sections.flatMap((s, si) =>
  s.cards.map((c, i) => ({ id: `${si}-${i}`, s: si, tag: c.tag ?? '', q: c.q, a: c.a })),
);
const payload = JSON.stringify({
  key: `bw-cards-${chapter.slug}`,
  sections: deck.sections.map((s) => s.title),
  cards,
}).replace(/</g, '\\u003c');
---

<Base
  title={`Flashcards: Topic ${chapter.n} ${chapter.title} – Edexcel IGCSE Physics`}
  description={`${total} free revision flashcards for Edexcel IGCSE Physics Topic ${chapter.n}: ${chapter.title}. Flip, shuffle and track what you know.`}
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <nav class="flex flex-wrap gap-x-2 text-sm font-bold text-ink/60">
      <a href={url('igcse/')} class="hover:text-sky">IGCSE Physics</a> <span>›</span>
      <span>{unit.title}</span> <span>›</span>
      <a href={url(`igcse/${unit.slug}/${chapter.slug}/`)} class="hover:text-sky">Chapter {chapter.n}: {chapter.title}</a>
    </nav>

    <div class={`mt-4 rounded-[2rem] p-6 ${col.soft}`}>
      <p class="text-sm font-extrabold text-ink/60">🃏 Flashcards · {total} cards</p>
      <h1 class="mt-1 text-3xl font-extrabold leading-tight">{chapter.title}</h1>
      <p class="mt-2 text-sm text-ink/70">
        Read the question, say the answer out loud, then flip the card. Mark what you know and keep reviewing the rest.
      </p>
    </div>

    <!-- Controls -->
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <label class="sr-only" for="fc-section">Section</label>
      <select id="fc-section" class="rounded-full border-2 border-[#d6e0f5] bg-white px-4 py-2 text-sm font-bold">
        <option value="all">All sections</option>
        {deck.sections.map((s, i) => <option value={String(i)}>{s.title}</option>)}
      </select>
      <button id="fc-shuffle" class="btn bg-sun px-4 py-2 text-sm" type="button">🔀 Shuffle</button>
      <button id="fc-review-only" class="btn border-2 border-[#d6e0f5] bg-white px-4 py-2 text-sm" type="button" aria-pressed="false">
        ✗ Review only
      </button>
      <button id="fc-reset" class="ml-auto text-sm font-bold text-ink/50 underline" type="button">Reset progress</button>
    </div>

    <!-- Progress -->
    <div class="mt-5">
      <div class="flex justify-between text-sm font-bold text-ink/60">
        <span id="fc-count">Card 1 of {total}</span>
        <span><span id="fc-know">0</span> ✓ known · <span id="fc-review">0</span> ✗ to review</span>
      </div>
      <div class="mt-2 h-3 overflow-hidden rounded-full bg-white">
        <div id="fc-bar" class="h-full w-0 rounded-full bg-mint transition-all"></div>
      </div>
    </div>

    <!-- Card -->
    <div class="fc-scene mt-6">
      <button id="fc-card" class="fc-card" type="button" aria-label="Flip card">
        <span class="fc-face fc-front">
          <span class="fc-label">Question <span id="fc-tag" class="fc-tag"></span></span>
          <span id="fc-q" class="fc-body"></span>
          <span class="fc-hint">Tap to flip</span>
        </span>
        <span class="fc-face fc-back">
          <span class="fc-label">Answer</span>
          <span id="fc-a" class="fc-body"></span>
          <span class="fc-hint">Tap to flip back</span>
        </span>
      </button>
    </div>

    <p id="fc-empty" class="mt-6 hidden rounded-2xl bg-white p-6 text-center font-bold">
      🎉 Nothing to review here. Switch the filter or reset your progress.
    </p>

    <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <button id="fc-prev" class="btn justify-center border-2 border-[#d6e0f5] bg-white" type="button">← Prev</button>
      <button id="fc-bad" class="btn justify-center bg-coral text-white" type="button">✗ Review</button>
      <button id="fc-good" class="btn justify-center bg-mint text-white" type="button">✓ Know it</button>
      <button id="fc-next" class="btn justify-center border-2 border-[#d6e0f5] bg-white" type="button">Next →</button>
    </div>
    <p class="mt-4 text-center text-xs font-bold text-ink/50">
      Keyboard: Space = flip · ← → = move · 1 = review · 2 = know it
    </p>

    <p class="mt-10 text-center">
      <a href={url(`igcse/${unit.slug}/${chapter.slug}/`)} class="font-extrabold text-sky hover:underline">← Back to chapter notes</a>
    </p>

    <script id="fc-data" type="application/json" set:html={payload} />
  </div>
</Base>

<style is:global>
  .fc-scene { perspective: 1200px; }
  .fc-card {
    position: relative;
    display: grid;
    width: 100%;
    min-height: 16rem;
    cursor: pointer;
    text-align: left;
    transform-style: preserve-3d;
    transition: transform 0.45s ease;
  }
  .fc-card.is-flipped { transform: rotateY(180deg); }
  .fc-face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border-radius: 1.75rem;
    border: 3px solid;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .fc-front { background: var(--color-sky-soft); border-color: #9fd0ff; }
  .fc-back { background: var(--color-mint-soft); border-color: #8fe0c1; transform: rotateY(180deg); }
  .fc-label { font-family: var(--font-display); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #4a5a80; }
  .fc-tag { margin-left: 0.5rem; border-radius: 9999px; background: white; padding: 0.1rem 0.6rem; font-size: 0.7rem; letter-spacing: 0; text-transform: none; }
  .fc-body { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 0.5rem; font-size: 1.25rem; line-height: 1.5; color: var(--color-ink); }
  .fc-front .fc-body { font-size: 1.5rem; font-weight: 800; font-family: var(--font-display); }
  .fc-back .fc-body p:first-child { font-size: 1.6rem; font-weight: 800; font-family: var(--font-display); }
  .fc-back .fc-body p + p { font-size: 1.05rem; color: #3a4764; }
  .fc-hint { font-size: 0.75rem; font-weight: 700; color: #6b7aa0; }
  #fc-review-only[aria-pressed='true'] { background: var(--color-coral-soft); border-color: #ffb3b3; }
  @media (prefers-reduced-motion: reduce) { .fc-card { transition: none; } }
</style>

<script>
  type Card = { id: string; s: number; tag: string; q: string[]; a: string[] };
  const data = JSON.parse(document.getElementById('fc-data')!.textContent || '{}') as {
    key: string;
    sections: string[];
    cards: Card[];
  };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  let status: Record<string, 'know' | 'review'> = {};
  try {
    status = JSON.parse(localStorage.getItem(data.key) || '{}');
  } catch {}
  const save = () => {
    try {
      localStorage.setItem(data.key, JSON.stringify(status));
    } catch {}
  };

  let order = data.cards.slice();
  let deck: Card[] = order;
  let idx = 0;
  let reviewOnly = false;

  const card = $('fc-card');
  const html = (lines: string[]) => lines.map((l) => `<p>${l}</p>`).join('');

  function rebuild(keepId?: string) {
    const sec = $<HTMLSelectElement>('fc-section').value;
    deck = order.filter((c) => (sec === 'all' || String(c.s) === sec) && (!reviewOnly || status[c.id] === 'review'));
    const at = keepId ? deck.findIndex((c) => c.id === keepId) : -1;
    idx = at >= 0 ? at : 0;
    render();
  }

  function render() {
    const known = data.cards.filter((c) => status[c.id] === 'know').length;
    const rev = data.cards.filter((c) => status[c.id] === 'review').length;
    $('fc-know').textContent = String(known);
    $('fc-review').textContent = String(rev);
    $('fc-bar').style.width = `${(known / data.cards.length) * 100}%`;

    const empty = deck.length === 0;
    $('fc-empty').classList.toggle('hidden', !empty);
    card.parentElement!.classList.toggle('hidden', empty);
    if (empty) {
      $('fc-count').textContent = 'No cards';
      return;
    }
    const c = deck[idx];
    card.classList.remove('is-flipped');
    $('fc-q').innerHTML = html(c.q);
    $('fc-a').innerHTML = html(c.a);
    $('fc-tag').textContent = c.tag;
    $('fc-count').textContent = `Card ${idx + 1} of ${deck.length}`;
  }

  const go = (d: number) => {
    if (!deck.length) return;
    idx = (idx + d + deck.length) % deck.length;
    render();
  };
  const mark = (s: 'know' | 'review') => {
    if (!deck.length) return;
    status[deck[idx].id] = s;
    save();
    if (reviewOnly && s === 'know') rebuild();
    else go(1);
  };
  const flip = () => card.classList.toggle('is-flipped');

  card.addEventListener('click', flip);
  $('fc-prev').addEventListener('click', () => go(-1));
  $('fc-next').addEventListener('click', () => go(1));
  $('fc-good').addEventListener('click', () => mark('know'));
  $('fc-bad').addEventListener('click', () => mark('review'));
  $('fc-section').addEventListener('change', () => rebuild());
  $('fc-shuffle').addEventListener('click', () => {
    order = data.cards.slice().sort(() => Math.random() - 0.5);
    rebuild();
  });
  $('fc-review-only').addEventListener('click', (e) => {
    reviewOnly = !reviewOnly;
    (e.currentTarget as HTMLElement).setAttribute('aria-pressed', String(reviewOnly));
    rebuild();
  });
  $('fc-reset').addEventListener('click', () => {
    if (!confirm('Clear your known / review marks for this chapter?')) return;
    status = {};
    save();
    rebuild();
  });
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (['SELECT', 'INPUT', 'TEXTAREA'].includes(t.tagName)) return;
    if (e.key === ' ' && t.id !== 'fc-card') {
      e.preventDefault();
      flip();
    } else if (e.key === 'ArrowRight') go(1);
    else if (e.key === 'ArrowLeft') go(-1);
    else if (e.key === '1') mark('review');
    else if (e.key === '2') mark('know');
  });

  render();
</script>
