---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { IGCSE, COLORS } from '../../data/curriculum';
import { url } from '../../lib/url';

const lessons = await getCollection('lessons');
const countFor = (chapterSlug: string) => lessons.filter((l) => l.id.split('/')[2] === chapterSlug).length;
---

<Base
  title="Edexcel IGCSE Physics (4XPH1) – Notes by Unit and Topic"
  description="Free Edexcel IGCSE Physics notes organised Unit by Unit and Topic by Topic in specification order, with diagrams, worked examples and exam tips."
>
  <div class="mx-auto max-w-6xl px-4 py-12">
    <p class="inline-block rounded-full bg-mint-soft px-4 py-1 text-sm font-extrabold text-emerald-800">🌱 O Level / IGCSE</p>
    <h1 class="mt-3 text-4xl font-extrabold">Edexcel IGCSE Physics</h1>
    <p class="mt-2 max-w-2xl text-ink/70">
      Follow the course in the same order as the Edexcel book: pick a unit, open a chapter, then work through its
      topics one by one.
    </p>

    {IGCSE.map((unit) => (
      <section class="mt-12">
        <div class="flex flex-wrap items-baseline gap-3">
          <h2 class="rounded-full bg-sun px-5 py-2 text-2xl font-extrabold">{unit.title}</h2>
          <p class="font-bold text-ink/60">{unit.subtitle}</p>
        </div>

        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {unit.chapters.map((c) => {
            const n = countFor(c.slug);
            const col = COLORS[c.color];
            const ready = n > 0;
            const Tag = ready ? 'a' : 'div';
            return (
              <Tag
                {...(ready ? { href: url(`igcse/${unit.slug}/${c.slug}/`) } : {})}
                class:list={['card block p-6', ready ? col.soft : 'bg-white/70']}
              >
                <div class="flex items-center gap-4">
                  <div class={`grid h-14 w-14 shrink-0 place-items-center rounded-2xl bg-white text-3xl`}>{c.emoji}</div>
                  <div>
                    <p class="text-sm font-extrabold text-ink/50">Chapter {c.n} · Spec {c.spec}</p>
                    <h3 class="text-xl font-extrabold leading-tight">{c.title}</h3>
                  </div>
                </div>
                <p class="mt-3 text-sm text-ink/70">{c.blurb}</p>
                <p class="mt-4 text-sm font-extrabold">
                  {ready ? (
                    <span class={col.text}>{n} topics →</span>
                  ) : (
                    <span class="rounded-full bg-cream px-3 py-1 text-ink/60">Coming soon</span>
                  )}
                </p>
              </Tag>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</Base>
