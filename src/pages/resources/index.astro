---
import Base from '../../layouts/Base.astro';
import { LEVELS, specsFor } from '../../data/curriculum';
import { url } from '../../lib/url';

const levels = (['o-level', 'a-level'] as const).map((slug) => {
  const specs = specsFor(slug);
  return { slug, ...LEVELS[slug], live: specs.filter((s) => s.status === 'live').length, total: specs.length };
});

const soon = [
  { icon: '🧪', bg: 'bg-mint-soft', title: 'End-of-topic tests', text: 'Timed tests to check your exam readiness.' },
  { icon: '📄', bg: 'bg-sky-soft', title: 'Formula sheets', text: 'One-page summaries of every key formula.' },
  { icon: '🗒️', bg: 'bg-coral-soft', title: 'Revision packs', text: 'Short notes for quick last-minute revision.' },
  { icon: '🔬', bg: 'bg-sun-soft', title: 'Required practicals', text: 'Method, results and exam questions for each practical.' },
];
---

<Base
  title="Free Physics Resources"
  description="Free O Level and A Level Physics revision resources by specification: flashcards and practice questions, with more added all the time."
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-extrabold">Free Resources</h1>
    <p class="mt-2 max-w-2xl text-ink/70">
      Flashcards and practice questions for every specification. Pick your level, then your specification, then your
      chapter. Everything is free, with no sign-up.
    </p>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {levels.map((l) => (
        <a href={url(`resources/${l.slug}/`)} class:list={['card block p-8', l.slug === 'o-level' ? 'bg-mint-soft' : 'bg-grape-soft']}>
          <p class="text-5xl">{l.emoji}</p>
          <h2 class="mt-3 text-2xl font-extrabold">{l.title} resources</h2>
          <p class="mt-2 text-ink/70">{l.blurb}</p>
          <p class="mt-4 font-extrabold">
            {l.live > 0 ? `${l.live} of ${l.total} specifications ready →` : 'Coming soon →'}
          </p>
        </a>
      ))}
    </div>

    <section class="mt-14">
      <h2 class="text-2xl font-extrabold">Coming soon</h2>
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        {soon.map((i) => (
          <div class="card p-6">
            <div class={`grid h-14 w-14 place-items-center rounded-2xl text-3xl ${i.bg}`}>{i.icon}</div>
            <h3 class="mt-4 text-xl font-extrabold">{i.title}</h3>
            <p class="mt-2 text-ink/70">{i.text}</p>
            <span class="mt-4 inline-block rounded-full bg-cream px-3 py-1 text-xs font-extrabold text-ink/60">Coming soon</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>
