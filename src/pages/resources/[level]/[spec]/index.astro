---
import Base from '../../../../layouts/Base.astro';
import UnitBlock from '../../../../components/UnitBlock.astro';
import { LEVELS, liveSpecs, findSpec } from '../../../../data/curriculum';
import { url } from '../../../../lib/url';

export function getStaticPaths() {
  return liveSpecs().map((s) => ({ params: { level: s.level, spec: s.slug } }));
}

const spec = findSpec(Astro.params.spec!)!;
const info = LEVELS[spec.level];
---

<Base
  title={`${spec.name} – Free Resources`}
  description={`Free flashcards and practice questions for ${spec.name}, organised unit by unit and chapter by chapter.`}
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <nav class="flex flex-wrap gap-x-2 text-sm font-bold text-ink/60">
      <a href={url('resources/')} class="hover:text-sky">Free Resources</a> <span>›</span>
      <a href={url(`resources/${spec.level}/`)} class="hover:text-sky">{info.title}</a> <span>›</span>
      <span>{spec.name}</span>
    </nav>

    <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <h1 class="text-4xl font-extrabold">{spec.name}</h1>
        <p class="mt-1 font-bold text-ink/60">{spec.code && <>Specification {spec.code} · </>}Free resources</p>
      </div>
      <a
        href={url(`${spec.level}/${spec.slug}/`)}
        class="shrink-0 rounded-full bg-sun-soft px-3 py-1 text-xs font-extrabold text-ink/80 hover:bg-sun hover:text-ink"
      >
        Read the notes →
      </a>
    </div>

    {spec.units.map((unit) => <UnitBlock spec={spec} unit={unit} mode="resources" unitLink />)}
  </div>
</Base>
