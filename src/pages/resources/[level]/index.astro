---
import Base from '../../../layouts/Base.astro';
import { BOARDS, LEVELS, specsFor, type LevelSlug } from '../../../data/curriculum';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return (['o-level', 'a-level'] as const).map((level) => ({ params: { level } }));
}

const level = Astro.params.level as LevelSlug;
const info = LEVELS[level];
const groups = BOARDS.map((board) => ({ board, specs: specsFor(level).filter((s) => s.board === board) })).filter(
  (g) => g.specs.length,
);
---

<Base
  title={`${info.title} Physics Resources – All Specifications`}
  description={`Free ${info.title} Physics flashcards and practice questions. Choose your specification.`}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="flex flex-wrap gap-x-2 text-sm font-bold text-ink/60">
      <a href={url('resources/')} class="hover:text-sky">Free Resources</a> <span>›</span>
      <span>{info.title}</span>
    </nav>
    <h1 class="mt-3 text-4xl font-extrabold">{info.title} resources</h1>
    <p class="mt-2 max-w-2xl text-ink/70">Choose your specification to see its free resources, unit by unit.</p>

    {groups.map((g) => (
      <section class="mt-10">
        <h2 class="inline-block rounded-full bg-sun px-5 py-2 text-2xl font-extrabold">{g.board}</h2>
        <ul class="card mt-4 divide-y-2 divide-[#e6edf9] overflow-hidden">
          {g.specs.map((s) => (
            <li>
              {s.status === 'live' ? (
                <a href={url(`resources/${s.level}/${s.slug}/`)} class="flex items-center gap-4 px-4 py-4 hover:bg-sun-soft">
                  <span class="min-w-0 flex-1">
                    <span class="block font-display text-lg font-extrabold leading-tight">{s.name}</span>
                    <span class="block text-sm text-ink/60">{s.code && <>Code {s.code} · </>}Flashcards and practice questions</span>
                  </span>
                  <span class="text-2xl text-ink/30">→</span>
                </a>
              ) : (
                <div class="flex items-center gap-4 px-4 py-4 opacity-60">
                  <span class="min-w-0 flex-1">
                    <span class="block font-display text-lg font-extrabold leading-tight">{s.name}</span>
                    <span class="block text-sm">{s.code && <>Code {s.code} · </>}Coming soon</span>
                  </span>
                  <span class="rounded-full bg-[#eef2fb] px-3 py-1 text-xs font-extrabold">Soon</span>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
