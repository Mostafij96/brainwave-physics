---
import { getCollection } from 'astro:content';
import Base from '../../../../../layouts/Base.astro';
import { COLORS, LEVELS, allChapters } from '../../../../../data/curriculum';
import { resourcesFor } from '../../../../../lib/resources';
import { url } from '../../../../../lib/url';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons');
  return allChapters()
    .filter(({ spec, unit, chapter }) => lessons.some((l) => l.id.startsWith(`${spec.slug}/${unit.slug}/${chapter.slug}/`)))
    .map(({ spec, unit, chapter }) => ({
      params: { level: spec.level, spec: spec.slug, unit: unit.slug, chapter: chapter.slug },
      props: { spec, unit, chapter },
    }));
}

const { spec, unit, chapter } = Astro.props;
const col = COLORS[chapter.color];
const info = LEVELS[spec.level];
const prefix = `${spec.slug}/${unit.slug}/${chapter.slug}/`;

const lessons = (await getCollection('lessons'))
  .filter((l) => l.id.startsWith(prefix))
  .sort((a, b) => a.data.order - b.data.order);
const totalMinutes = lessons.reduce((s, l) => s + l.data.minutes, 0);
const base = `${spec.level}/${spec.slug}/${unit.slug}/${chapter.slug}`;
const lessonSlug = (id: string) => id.split('/')[3];
const res = await resourcesFor(spec.slug, chapter.slug);
const resHref = url(`resources/${spec.level}/${spec.slug}/${unit.slug}/${chapter.slug}/`);
---

<Base
  title={`Topic ${chapter.n}: ${chapter.title} – ${spec.name}`}
  description={`${spec.name} Topic ${chapter.n}: ${chapter.title}. ${chapter.blurb}`}
>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <nav class="flex flex-wrap gap-x-2 text-sm font-bold text-ink/60">
      <a href={url(`${spec.level}/`)} class="hover:text-sky">{info.title}</a> <span>›</span>
      <a href={url(`${spec.level}/${spec.slug}/`)} class="hover:text-sky">{spec.name}</a> <span>›</span>
      <span>{unit.title}</span> <span>›</span>
      <span>Chapter {chapter.n}</span>
    </nav>

    <div class={`mt-4 rounded-[2rem] p-8 ${col.soft}`}>
      <div class="flex items-center gap-4">
        <div class="grid h-16 w-16 place-items-center rounded-2xl bg-white text-4xl">{chapter.emoji}</div>
        <div>
          <p class="text-sm font-extrabold text-ink/60">{unit.title} · Chapter {chapter.n} · Spec {chapter.spec}</p>
          <h1 class="text-3xl font-extrabold leading-tight md:text-4xl">{chapter.title}</h1>
        </div>
      </div>
      <p class="mt-4 text-ink/75">{chapter.blurb}</p>
      <p class="mt-3 text-sm font-bold text-ink/60">{lessons.length} topics · about {totalMinutes} min of reading</p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <a href={url(`${base}/${lessonSlug(lessons[0].id)}/`)} class="btn bg-sky text-white shadow-[0_5px_0_#1c78cc]">
          Start with topic 1 →
        </a>
        {(res.deck || res.hasPractice) && (
          <a href={resHref} class="rounded-full bg-white px-4 py-2 text-sm font-extrabold hover:bg-sun">
            Free resources for this chapter →
          </a>
        )}
      </div>
    </div>

    <h2 class="mt-10 text-2xl font-extrabold">Topics in this chapter</h2>
    <ol class="mt-4 space-y-4">
      {lessons.map((l) => (
        <li>
          <a href={url(`${base}/${lessonSlug(l.id)}/`)} class="card flex items-center gap-4 p-4">
            <span class={`grid h-12 w-12 shrink-0 place-items-center rounded-2xl font-display text-xl font-extrabold ${col.badge}`}>
              {l.data.order}
            </span>
            <span class="flex-1">
              <span class="block text-lg font-extrabold leading-tight">{l.data.title}</span>
              <span class="mt-1 block text-sm text-ink/60">
                {l.data.specRange ? `Spec ${l.data.specRange}` : 'Practice'} · ⏱ {l.data.minutes} min
              </span>
            </span>
            <span class="text-2xl text-ink/30">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>
