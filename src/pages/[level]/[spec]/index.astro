---
import Base from '../../../layouts/Base.astro';
import UnitBlock from '../../../components/UnitBlock.astro';
import { LEVELS, liveSpecs, findSpec } from '../../../data/curriculum';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return liveSpecs().map((s) => ({ params: { level: s.level, spec: s.slug } }));
}

const spec = findSpec(Astro.params.spec!)!;
const info = LEVELS[spec.level];
---

<Base
  title={`${spec.name}${spec.code ? ` (${spec.code})` : ''} – Notes by Unit and Topic`}
  description={`Free ${spec.name} notes organised unit by unit and topic by topic in specification order, with diagrams, worked examples and exam tips.`}
>
  <div class="mx-auto max-w-5xl px-4 py-12">
    <nav class="flex flex-wrap gap-x-2 text-sm font-bold text-ink/60">
      <a href={url(`${spec.level}/`)} class="hover:text-sky">{info.title}</a> <span>›</span>
      <span>{spec.board}</span>
    </nav>

    <div class="mt-3 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="inline-block rounded-full bg-mint-soft px-4 py-1 text-sm font-extrabold text-emerald-800">
          {info.emoji} {spec.board} · {info.title}
        </p>
        <h1 class="mt-3 text-4xl font-extrabold">{spec.name}</h1>
        <p class="mt-1 font-bold text-ink/60">{spec.code && <>Specification {spec.code}</>}</p>
      </div>
      <a
        href={url(`resources/${spec.level}/${spec.slug}/`)}
        class="shrink-0 rounded-full bg-sun-soft px-3 py-1 text-xs font-extrabold text-ink/80 hover:bg-sun hover:text-ink"
      >
        All free resources →
      </a>
    </div>
    <p class="mt-3 max-w-2xl text-ink/70">
      Follow the course in specification order: pick a unit, open a chapter, then work through its topics one by one.
    </p>

    {spec.units.map((unit) => <UnitBlock spec={spec} unit={unit} mode="learn" />)}
  </div>
</Base>
